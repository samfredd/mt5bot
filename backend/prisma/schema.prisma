generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  VIEWER
}

enum TradingMode {
  MANUAL
  SEMI_AUTO
  AUTO
  COPY
}

enum TradeDirection {
  BUY
  SELL
}

enum TradeStatus {
  ANALYZED
  PENDING_APPROVAL
  APPROVED
  SUBMITTING
  PARTIALLY_FILLED
  UNKNOWN
  REJECTED
  RISK_BLOCKED
  EXECUTED
  FAILED
  CLOSED
  CANCELLED
}

enum OrderIntentStatus {
  PREPARED
  SUBMITTING
  PLACED
  PARTIALLY_FILLED
  FILLED
  REJECTED
  UNKNOWN
  CANCELLED
}

enum ApprovalChannel {
  DASHBOARD
  TELEGRAM
  WHATSAPP
}

enum NewsImpact {
  LOW
  MEDIUM
  HIGH
}

enum NotificationChannel {
  WEB
  TELEGRAM
  WHATSAPP
  EMAIL
}

enum IncidentSeverity {
  INFO
  WARNING
  CRITICAL
}

enum IncidentStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

enum ValidationStatus {
  PASSED
  FAILED
  INVALID
  ERROR
}

enum PaperTradeStatus {
  OPEN
  CLOSED
  CANCELLED
}

model User {
  id                 String         @id @default(cuid())
  email              String         @unique
  passwordHash       String
  role               Role           @default(VIEWER)
  totpSecret         String?
  totpEnabled        Boolean        @default(false)
  liveTradingEnabled Boolean        @default(false)
  createdAt          DateTime       @default(now())
  accounts           Mt5Account[]
  strategies         Strategy[]
  riskSettings       RiskSettings?
  trades             Trade[]
  telegramUsers      TelegramUser[]
  whatsappUsers      WhatsappUser[]
  notifications      Notification[]
  copyTraders        CopyTrader[]
  notificationPrefs  Json           @default("{}")
  validationRuns     ValidationRun[]
  paperTrades        PaperTrade[]
  executionComparisons ExecutionComparison[]
  journalEntries     TradeJournalEntry[]
  tradingMemories    TradingMemory[]
  orderIntents       OrderIntent[]
}

model Mt5Account {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id])
  label             String
  login             String
  server            String
  isDemo            Boolean  @default(true)
  verified          Boolean  @default(false)
  // AES-256-GCM encrypted investor/trade password; never stored in plaintext
  passwordEnc       String?
  createdAt         DateTime @default(now())
  // Soft removal keeps historical trades attributable to this account while
  // hiding it from account management and clearing its reusable credentials.
  archivedAt        DateTime?
  trades            Trade[]
  orderIntents      OrderIntent[]
  marketReservations MarketReservation[]

  // One saved row per login per user: lets register()/connect() upsert by login
  // and slams the door on the duplicate-row race (two concurrent cache-miss
  // auto-registrations both inserting the same login).
  @@unique([userId, login])
}

model Strategy {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  name      String
  type      String // trend_following | scalping | swing | price_action | news_aware | copy | custom
  enabled   Boolean  @default(false)
  // symbols, timeframes, entry/exit rules, SL/TP logic, lot sizing,
  // maxTradesPerDay, sessions, newsBehavior, riskLimits
  config    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  trades    Trade[]
  validationRuns ValidationRun[]
  paperTrades PaperTrade[]
}

model ValidationRun {
  id               String           @id @default(cuid())
  userId           String
  user             User             @relation(fields: [userId], references: [id])
  strategyId       String?
  strategy         Strategy?        @relation(fields: [strategyId], references: [id], onDelete: SetNull)
  candidateName    String
  symbol           String
  status           ValidationStatus
  trigger          String
  trainStart       DateTime?
  trainEnd         DateTime?
  oosStart         DateTime?
  oosEnd           DateTime?
  instruments      Json             @default("[]")
  metrics          Json             @default("{}")
  gates            Json             @default("{}")
  rejectionReasons Json             @default("[]")
  createdAt        DateTime         @default(now())

  @@index([userId, createdAt])
  @@index([strategyId, createdAt])
}

model PaperTrade {
  id                     String           @id @default(cuid())
  userId                 String
  user                   User             @relation(fields: [userId], references: [id])
  strategyId             String?
  strategy               Strategy?        @relation(fields: [strategyId], references: [id], onDelete: SetNull)
  symbol                 String
  direction              TradeDirection
  lots                   Float
  proposedEntry          Float
  entryPrice             Float
  stopLoss               Float?
  takeProfit             Float?
  expectedSpreadPoints   Float
  expectedSlippagePoints Float
  expectedCommission     Float
  instrumentSpec         Json
  marketSnapshot         Json             @default("{}")
  explanation            Json             @default("{}")
  status                 PaperTradeStatus @default(OPEN)
  openedAt               DateTime
  lastMarkedAt           DateTime?
  closedAt               DateTime?
  exitPrice              Float?
  exitReason             String?
  profit                 Float?
  promotedAt             DateTime?
  promotedTradeId        String?          @unique
  promotedTrade          Trade?           @relation("PaperPromotion", fields: [promotedTradeId], references: [id], onDelete: SetNull)
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  @@index([userId, status, createdAt])
  @@index([strategyId, createdAt])
}

model ExecutionComparison {
  id                     String         @id @default(cuid())
  tradeId                String         @unique
  trade                  Trade          @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  userId                 String
  user                   User           @relation(fields: [userId], references: [id])
  direction              TradeDirection
  expectedEntry          Float
  actualEntry            Float
  expectedExit           Float?
  actualExit             Float?
  expectedSpreadPoints   Float?
  actualSpreadPoints     Float?
  expectedSlippagePoints Float?
  entrySlippage          Float
  exitSlippage           Float?
  entryVariancePct       Float
  exitVariancePct        Float?
  requestedAt            DateTime
  filledAt               DateTime?
  latencyMs              Int?
  expectedPnl            Float?
  actualPnl              Float?
  pnlVariance            Float?
  pnlVariancePct         Float?
  attributionConfidence  Float?
  attributionReason      String?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  @@index([userId, createdAt])
}

model TradeJournalEntry {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  tradeId   String   @unique
  trade     Trade    @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  notes     String
  tags      Json     @default("[]")
  lessons   String
  rating    Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, tradeId])
  @@index([userId, updatedAt])
}

model RiskSettings {
  id                     String  @id @default(cuid())
  userId                 String  @unique
  user                   User    @relation(fields: [userId], references: [id])
  maxRiskPerTradePct     Float   @default(1.0)
  maxDailyLossPct        Float   @default(3.0)
  maxWeeklyLossPct       Float   @default(6.0)
  maxDrawdownPct         Float   @default(10.0)
  maxOpenTrades          Int     @default(5)
  maxTradesPerSymbol     Int     @default(2)
  maxTradesPerDay        Int     @default(10)
  maxLotSize             Float   @default(0.5)
  minRiskReward          Float   @default(1.5)
  requireStopLoss        Boolean @default(true)
  requireTakeProfit      Boolean @default(false)
  maxSpreadPoints        Float   @default(30)
  maxAtrVolatilityPct    Float   @default(3.0)
  newsRiskLimit          NewsImpact @default(MEDIUM)
  pauseBeforeNewsMin     Int     @default(30)
  pauseAfterNewsMin      Int     @default(30)
  allowNewsTrading       Boolean @default(false)
  allowedSessions        Json    @default("[\"london\",\"newyork\"]")
  equityProtectionPct    Float   @default(80.0)
  copyExposureLimitPct   Float   @default(20.0)
  maxDailyCopiedTrades   Int     @default(10)
  // Circuit breaker: stop opening trades after N consecutive losses today
  maxConsecutiveLosses   Int     @default(3)
  maxCurrencyExposurePct Float  @default(600)
  maxCorrelatedExposurePct Float @default(600)
  autoFlattenNewsEnabled Boolean @default(false)
  autoFlattenLeadMin Int @default(15)
  autoFlattenMinimumImpact NewsImpact @default(HIGH)
  autoFlattenSymbols Json @default("[]")
}

model Trade {
  id            String         @id @default(cuid())
  userId        String
  user          User           @relation(fields: [userId], references: [id])
  accountId     String?
  account       Mt5Account?    @relation(fields: [accountId], references: [id])
  strategyId    String?
  strategy      Strategy?      @relation(fields: [strategyId], references: [id])
  symbol        String
  direction     TradeDirection
  lots          Float
  entryPrice    Float?
  stopLoss      Float?
  takeProfit    Float?
  status        TradeStatus
  mode          TradingMode
  mt5Ticket     String?
  profit        Float?
  openedAt      DateTime?
  closedAt      DateTime?
  // Time-based exit: auto-close this many minutes after opening (null = no limit)
  closeAfterMin Int?
  createdAt     DateTime       @default(now())
  // Full decision trail: strategy signal, AI verdict, risk checks, news risk
  explanation   Json           @default("{}")
  aiAnalysisId  String?
  aiAnalysis    AiAnalysisLog? @relation(fields: [aiAnalysisId], references: [id])
  approval      TradeApproval?
  copiedTrade   CopiedTrade?
  executionComparison ExecutionComparison?
  paperSource     PaperTrade?     @relation("PaperPromotion")
  attributionConfidence Float?
  attributionReason String?
  brokerExitPrice Float?
  journalEntry TradeJournalEntry?
  memoryEntry TradingMemory?
  orderIntent OrderIntent?

  @@index([accountId, createdAt])
}

model OrderIntent {
  id                    String            @id @default(cuid())
  clientOrderId         String            @unique
  userId                String
  user                  User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId             String
  account               Mt5Account        @relation(fields: [accountId], references: [id])
  tradeId               String            @unique
  trade                 Trade             @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  marketKey             String
  expectedLogin         String
  expectedServer        String
  request               Json
  status                OrderIntentStatus @default(PREPARED)
  requestedVolume       Float
  filledVolume          Float             @default(0)
  brokerOrderId         String?
  brokerDealId          String?
  brokerPositionId      String?
  retcode               Int?
  error                 String?
  submittedAt           DateTime?
  resolvedAt            DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  reservation           MarketReservation?

  @@index([status, updatedAt])
  @@index([accountId, marketKey, status])
}

model MarketReservation {
  id          String      @id @default(cuid())
  accountId   String
  account     Mt5Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  marketKey   String
  intentId    String      @unique
  intent      OrderIntent @relation(fields: [intentId], references: [id], onDelete: Cascade)
  status      String      @default("ACTIVE")
  expiresAt   DateTime
  createdAt   DateTime    @default(now())
  releasedAt  DateTime?

  @@unique([accountId, marketKey])
  @@index([status, expiresAt])
}

model TradingMemory {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tradeId         String   @unique
  trade           Trade    @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  symbol          String
  direction       TradeDirection
  strategyId      String?
  strategyName    String?
  source          String
  outcome         String
  profit          Float
  rMultiple       Float?
  aiDecision      String?
  aiConfidence    Float?
  marketRegime    String?
  newsRisk        String?
  closeReason     String?
  lesson          String
  mistakes        Json     @default("[]")
  strengths       Json     @default("[]")
  context         Json     @default("{}")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId, symbol, createdAt])
  @@index([userId, strategyId, createdAt])
  @@index([userId, outcome, createdAt])
}

model TradeApproval {
  id          String           @id @default(cuid())
  tradeId     String           @unique
  trade       Trade            @relation(fields: [tradeId], references: [id])
  requestedAt DateTime         @default(now())
  expiresAt   DateTime
  decidedAt   DateTime?
  decidedBy   String?
  channel     ApprovalChannel?
  status      String           @default("pending") // pending | approved | rejected | expired
}

model CopyTrader {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id])
  name         String
  source       String // manual | signal_provider id / url
  active       Boolean       @default(false)
  // winRate, profitFactor, drawdown, avgMonthlyReturn, consistency,
  // accountAgeMonths, tradingFrequency, avgTradeDurationH, lossStreakMax,
  // symbolSpecialization, lotBehavior, newsBehavior
  metrics      Json          @default("{}")
  riskScore    Float         @default(50)
  // lotMultiplier, fixedLot, maxRiskPerCopiedTradePct, symbolsAllowed,
  // symbolsBlocked, stopAfterDrawdownPct, stopAfterLossStreak
  copyRules    Json          @default("{}")
  createdAt    DateTime      @default(now())
  copiedTrades CopiedTrade[]
}

model CopiedTrade {
  id           String     @id @default(cuid())
  copyTraderId String
  copyTrader   CopyTrader @relation(fields: [copyTraderId], references: [id])
  tradeId      String     @unique
  trade        Trade      @relation(fields: [tradeId], references: [id])
  sourceRef    String?
  createdAt    DateTime   @default(now())
}

model NewsEvent {
  id        String     @id @default(cuid())
  title     String
  country   String?
  currency  String?
  impact    NewsImpact
  eventTime DateTime
  forecast  String?
  previous  String?
  source    String
  raw       Json       @default("{}")
  createdAt DateTime   @default(now())

  @@unique([title, eventTime])
}

model IntelligenceSource {
  id                  String   @id @default(cuid())
  slug                String   @unique
  name                String
  category            String
  accessMethod        String
  homepageUrl         String?
  feedUrl             String?
  enabled             Boolean  @default(false)
  approved            Boolean  @default(false)
  official            Boolean  @default(false)
  baseReliability     Float    @default(0.5)
  reliabilityScore    Float    @default(0.5)
  pollIntervalMin     Int      @default(60)
  termsNote           String?
  healthStatus        String   @default("UNKNOWN")
  consecutiveFailures Int      @default(0)
  lastFetchedAt       DateTime?
  nextFetchAt         DateTime?
  lastError           String?
  rateLimitRemaining  Int?
  config              Json     @default("{}")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  items               IntelligenceItem[]
  ingestionRuns       IntelligenceIngestionRun[]

  @@index([enabled, nextFetchAt])
  @@index([category, reliabilityScore])
}

model IntelligenceStory {
  id                String   @id @default(cuid())
  fingerprint       String   @unique
  title             String
  topic             String
  summary           String?
  verificationStatus String  @default("UNCONFIRMED")
  confirmationCount Int      @default(0)
  sourceCount       Int      @default(0)
  relatedAssets     Json     @default("[]")
  firstSeenAt       DateTime
  lastSeenAt        DateTime
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  items             IntelligenceItem[]
  claims            IntelligenceClaim[]

  @@index([verificationStatus, lastSeenAt])
}

model IntelligenceItem {
  id                      String   @id @default(cuid())
  sourceId                String
  source                  IntelligenceSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  storyId                 String?
  story                   IntelligenceStory? @relation(fields: [storyId], references: [id], onDelete: SetNull)
  externalId              String?
  canonicalUrl            String?
  title                   String
  author                  String?
  content                 String
  summary                 String?
  kind                    String   @default("NEWS")
  topic                   String   @default("OTHER")
  factuality              String   @default("REPORT")
  verificationStatus      String   @default("UNCONFIRMED")
  sentiment               String   @default("NEUTRAL")
  urgency                 String   @default("NORMAL")
  expectedImpact          String   @default("LOW")
  credibilityScore        Float    @default(0.5)
  relevanceScore          Float    @default(0)
  noveltyScore            Float    @default(1)
  communityMomentum       Float    @default(0)
  promptInjectionDetected Boolean  @default(false)
  relatedAssets           Json     @default("[]")
  countries               Json     @default("[]")
  entities                Json     @default("[]")
  claims                  Json     @default("[]")
  engagement              Json     @default("{}")
  raw                     Json     @default("{}")
  contentHash             String
  searchText              String
  embedding               Json     @default("[]")
  publishedAt             DateTime?
  retrievedAt             DateTime @default(now())
  expiresAt               DateTime?
  reviewedAt              DateTime?
  approvedByUser          Boolean  @default(false)
  archivedAt              DateTime?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  claimRecords            IntelligenceClaim[]

  @@unique([sourceId, contentHash])
  @@index([storyId, publishedAt])
  @@index([verificationStatus, relevanceScore])
  @@index([kind, publishedAt])
}

model IntelligenceClaim {
  id                 String   @id @default(cuid())
  storyId            String
  story              IntelligenceStory @relation(fields: [storyId], references: [id], onDelete: Cascade)
  itemId             String
  item               IntelligenceItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  claimHash          String
  text               String
  stance             String   @default("SUPPORTS")
  verificationStatus String   @default("UNCONFIRMED")
  confidence         Float    @default(0.5)
  createdAt          DateTime @default(now())

  @@unique([itemId, claimHash])
  @@index([storyId, claimHash])
}

model KnowledgeEntry {
  id                 String   @id @default(cuid())
  key                String   @unique
  type               String
  title              String
  content            String
  confidence         Float    @default(0.5)
  verificationStatus String   @default("UNCONFIRMED")
  status             String   @default("PENDING")
  userApproved       Boolean  @default(false)
  approvalMethod     String?
  approvalDecision   String?
  approvalReason     String?
  approvalConfidence Float?
  approvedBy         String?
  approvedAt         DateTime?
  provenance         Json     @default("[]")
  relatedAssets      Json     @default("[]")
  entities           Json     @default("[]")
  embedding          Json     @default("[]")
  currentVersion     Int      @default(1)
  validFrom          DateTime @default(now())
  expiresAt          DateTime?
  reviewAt           DateTime?
  lastValidatedAt    DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  versions           KnowledgeVersion[]

  @@index([status, reviewAt])
  @@index([type, updatedAt])
}

model KnowledgeVersion {
  id                 String   @id @default(cuid())
  knowledgeEntryId   String
  knowledgeEntry     KnowledgeEntry @relation(fields: [knowledgeEntryId], references: [id], onDelete: Cascade)
  version            Int
  content            String
  confidence         Float
  verificationStatus String
  changeReason       String
  provenance         Json     @default("[]")
  changedBy          String
  createdAt          DateTime @default(now())

  @@unique([knowledgeEntryId, version])
}

model IntelligenceIngestionRun {
  id                 String   @id @default(cuid())
  sourceId           String?
  source             IntelligenceSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  jobType            String
  idempotencyKey     String   @unique
  status             String   @default("RUNNING")
  fetchedCount       Int      @default(0)
  storedCount        Int      @default(0)
  duplicateCount     Int      @default(0)
  errorCount         Int      @default(0)
  error              String?
  rateLimit          Json     @default("{}")
  detail             Json     @default("{}")
  startedAt          DateTime @default(now())
  completedAt        DateTime?

  @@index([status, startedAt])
  @@index([sourceId, startedAt])
}

model ResearchBrief {
  id          String   @id @default(cuid())
  type        String
  periodStart DateTime
  periodEnd   DateTime
  title       String
  content     String
  citations   Json     @default("[]")
  createdAt   DateTime @default(now())

  @@unique([type, periodStart, periodEnd])
}

model AiAnalysisLog {
  id         String   @id @default(cuid())
  symbol     String
  model      String
  prompt     String
  response   Json
  decision   String?
  confidence Float?
  valid      Boolean  @default(true)
  createdAt  DateTime @default(now())
  trades     Trade[]
}

model TelegramUser {
  id         String  @id @default(cuid())
  userId     String
  user       User    @relation(fields: [userId], references: [id])
  telegramId String  @unique
  chatId     String?
  verified   Boolean @default(false)
  linkCode   String?
}

model WhatsappUser {
  id       String  @id @default(cuid())
  userId   String
  user     User    @relation(fields: [userId], references: [id])
  phone    String  @unique
  verified Boolean @default(false)
  linkCode String?
}

model Notification {
  id        String              @id @default(cuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id])
  channel   NotificationChannel
  type      String
  title     String
  body      String
  status    String              @default("pending") // pending | sent | failed
  createdAt DateTime            @default(now())
  sentAt    DateTime?
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  actor     String // user email / "system" / "telegram:<id>" / "whatsapp:<phone>"
  category  String // auth | trade | risk | strategy | news | copy | telegram | whatsapp | system
  action    String
  detail    Json     @default("{}")
  createdAt DateTime @default(now())

  @@index([category, createdAt])
}

model ErrorLog {
  id        String   @id @default(cuid())
  source    String
  message   String
  detail    Json     @default("{}")
  createdAt DateTime @default(now())
}

model Incident {
  id               String           @id @default(cuid())
  dedupeKey        String
  severity         IncidentSeverity
  status           IncidentStatus   @default(OPEN)
  source           String
  title            String
  message          String
  context          Json             @default("{}")
  occurrenceCount  Int              @default(1)
  firstSeenAt      DateTime         @default(now())
  lastSeenAt       DateTime         @default(now())
  acknowledgedAt   DateTime?
  acknowledgedBy   String?
  resolvedAt       DateTime?
  resolvedBy       String?

  @@index([status, lastSeenAt])
  @@index([dedupeKey, status])
}

model SystemSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
